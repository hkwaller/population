  "narrative": {
    "northStar": "The Playful Atlas",
    "overview": "Population\u2019s visual world is a playful atlas: warm terrain colours, ocean teal, geographic linework and confident Gabarito typography. The geography gives the game its own identity while its approachable controls keep a group of friends moving into play.\n\nThe approved atlas refinement now extends across the website and launcher, setup and lobby, answering and reveal, results and highscores, daily play, offline practice, and support/legal surfaces. It preserves the Population name, maker credit, content and gameplay scoring. Shared controls, panels, typography, contrast and motion carry the same identity across these different tasks; their page compositions remain purpose-specific.\n\nCoverage describes implemented source and reviewed surfaces, not universal runtime verification. Authenticated profile and admin were reviewed in source only. The local Clerk provider has atlas appearance settings; externally hosted sign-in remains outside the app\u2019s styling control.",
    "keyCharacteristics": [
      "Geographic imagery and static meridians establish the atlas identity.",
      "Level controls and shared panels use soft, blurred depth.",
      "Earthy route colours and bold type keep the party-game energy."
    ],
    "rules": [
      {
        "name": "The Geographic Signature Rule",
        "body": "Use the globe wordmark and static meridian linework as the shared identity cues.",
        "section": "overview"
      },
      {
        "name": "The Soft Depth Rule",
        "body": "Use the implemented blurred Pop shadows for controls and panels; avoid restoring hard offset block shadows to the refined primitives.",
        "section": "elevation & depth"
      },
      {
        "name": "The Level Surface Rule",
        "body": "Controls, wordmarks, tiles and panels stay level; motion communicates hover, press, entry or celebration rather than idle drift.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do use the existing earthy palette and Gabarito family.",
      "Do keep controls, wordmarks, tiles and panels level, with purposeful press or entry feedback.",
      "Do place the website globe after the actions when the intro stacks on mobile.",
      "Do preserve readable focus treatments, native safe areas and the maker credit.",
      "Do use ink for small labels on coral or mint and light text on teal, brown or ink.",
      "Do retain circles for geographic and player marks and pills for semantic labels, scores and switches."
    ],
    "donts": [
      "Don't restore floating category chips, decorative tilts, constant CTA bobbing or offset block shadows.",
      "Don't substitute invented continent silhouettes for the existing world-atlas vector geography.",
      "Don't treat confetti or real device-orientation handling as decorative rotation defects.",
      "Don't change gameplay scoring, content or launcher priorities as part of a visual refinement.",
      "Don't canonize isolated source outliers or claim externally hosted authentication and source-only reviews were visually verified."
    ]
  }
}
