{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "population.buzz"
        }
      ],
      "destination": "https://population.playam.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.population.buzz"
        }
      ],
      "destination": "https://population.playam.app/:path*",
      "permanent": true
    }
  ]
}
