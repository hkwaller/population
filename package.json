    "react-qr-code": "^2.0.14",
    "stripe": "^22.3.2",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "topojson-client": "^3.1.0",
    "uuid": "^10.0.0",
    "vaul": "^0.9.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
