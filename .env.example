# Copy to .env.local and fill in. Provision fresh projects (do NOT reuse ish's).


# --- Supabase (question bank + game stats) --- https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
# Service role key - used ONLY by scripts/migrate-questions.ts to seed. Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=xxx

# --- Clerk (auth; anonymous guests work without sign-in) --- https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Local dev flag ---
DEVELOPMENT=true

# --- REST Countries v5 (build-time only; regenerates lib/geo/countries.json) --- https://restcountries.com
RESTCOUNTRIES_API_KEY=rc_live_xxx

# Optional: override the public site URL for metadata and canonical links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Native app (NATIVE.md) ---
# Universal links / App Links. /.well-known/* returns 404 until these are set.
APPLE_TEAM_ID=
# Comma-separated SHA-256 signing cert fingerprints (Play Console > App integrity).
ANDROID_CERT_SHA256=

# Realtime rooms: shared HMAC secret in Next.js and the Worker
PARTY_SECRET=replace-with-openssl-rand-hex-32
NEXT_PUBLIC_PARTY_HOST=localhost:1999
