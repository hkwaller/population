{
  "name": "population",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "start-dev": "next dev",
    "reseed": "npx tsx --env-file=.env.local scripts/migrate-questions.ts",
    "native:offline": "rm -rf native/www/offline-assets && vite build --config native/offline/vite.config.ts",
    "native:sync": "npm run native:offline && cap sync",
    "native:dev": "export CAP_SERVER_URL=${CAP_SERVER_URL:-http://localhost:3000} && npm run native:offline && cap sync",
    "native:icons": "node scripts/native/icons.mjs && capacitor-assets generate --ios --android --assetPath native/assets --iconBackgroundColor #CC6B49 --iconBackgroundColorDark #CC6B49 --splashBackgroundColor #CC6B49 --splashBackgroundColorDark #CC6B49",
    "native:ios": "open ios/App/Population.xcworkspace",
    "native:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
